rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // कॅटलॉग साड्या (Products) - सर्व ग्राहकांना पाहता येतील व मालकाला अपडेट करता येतील
    match /products/{productId} {
      allow read, write: if true;
    }

    // ब्लाऊज डिझाईन्स (Designs) - सर्व ग्राहकांना पाहता येतील व मालकाला अपडेट करता येतील
    match /designs/{designId} {
      allow read, write: if true;
    }

    // इतर सर्व नोंदी कायमस्वरूपी सुरू राहण्यासाठी
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
